[options]
suppress_default_binds = true
background = 1a1b26

[aliases]
# Define aliases here. Any arguments passed to an alias are appended to the command.
# alias = command to run

[binds]
q = quit
y = exec echo working!

<Left> = prev
<bracketleft> = prev
<Right> = next
<bracketright> = next
gg = goto 1
<Shift+G> = goto -1

j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0

<Up> = zoom 1
<Shift+plus> = zoom 1
<Down> = zoom -1
<minus> = zoom -1

r = rotate by 90

x = close
f = fullscreen
o = overlay
p = exec echo $imv_current_file
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
<Ctrl+r> = reset

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1
